# Copy to server/.env and fill in ONE of the two options below.
# Never commit .env — it is gitignored.

# Option A: your own NVIDIA key from https://build.nvidia.com
NVIDIA_API_KEY=

# Option B: route through your API Rails workspace (nvidia connector)
API_RAILS_ENDPOINT=https://api.apirails.com
API_RAILS_KEY=

PORT=4000
